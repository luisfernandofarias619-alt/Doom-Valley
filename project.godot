; Engine configuration file.
; DOOM VALLEY — migração do HTML5 (v6.0) para Godot 4.

config_version=5

[application]

config/name="DOOM VALLEY"
config/description="N.E.X.U.S. — Neural Extension for X-scale Upgrade Software"
run/main_scene="res://scenes/core/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0196, 0.0196, 0.0314, 1)
boot_splash/show_image=false
config/icon="res://assets/sprites/icon.png"

[autoload]

Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
Assets="*res://scripts/autoload/assets.gd"
Sfx="*res://scripts/audio/sfx.gd"
Music="*res://scripts/audio/music.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

